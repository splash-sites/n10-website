# Database. A "file:" URL uses a local SQLite file (quick local work).
# A "postgres://" URL uses Postgres (Supabase in production): Supabase ›
# Project Settings › Database › Connection string › "Transaction pooler".
DATABASE_URL=file:./numero10.db
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public address of the site, used for links and share images
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Photo uploads in Supabase Storage (S3 protocol). Supabase › Storage ›
# create a bucket "media" › Settings › S3 access keys. Leave S3_BUCKET empty
# locally to keep uploads in ./media.
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Protects /cron/keepalive. Vercel sends it automatically to its cron jobs.
CRON_SECRET=replace-with-another-random-string

# Email for contact-form notifications (Resend SMTP: smtp.resend.com, port
# 587, user "resend", password = API key). Leave SMTP_HOST empty and the
# email is printed in the server log instead; messages are still saved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=website@numero10.com
