# Local development uses a SQLite file. In production point this to Postgres
# (and switch the adapter to @payloadcms/db-postgres).
DATABASE_URL=file:./numero10.db
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public address of the site, used for links and share images
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email for contact-form notifications. Leave SMTP_HOST empty in development:
# the email is then printed in the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=website@numero10.com
